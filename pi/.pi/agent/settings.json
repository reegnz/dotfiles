{
  "packages": [
    "npm:pi-env",
    "npm:pi-provider-litellm",
    "git:github.com/reegnz/ai-tmux",
    "git:github.com/DietrichGebert/ponytail",
    "npm:pi-web-access",
    "../../repos/github.com/reegnz/pi-extensions"
  ],
  "lastChangelogVersion": "1.5.0",
  "theme": "dark",
  "defaultProvider": "litellm",
  "defaultModel": "claude-haiku-5-5",
  "env": {
    "LLAMA_BASE_URL": "http://localhost:9931/v1",
    "BASH_SUMMARY_PROVIDER": "llama.cpp",
    "BASH_SUMMARY_MODEL": "ggml-org/gemma-4-E2B-it-GGUF:Q8_0"
  },
  "collapseChangelog": true,
  "quietStartup": false,
  "enableInstallTelemetry": false,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "tuiMode": "regular",
  "fullscreenExitOutput": "transcript",
  "hideThinkingBlock": false,
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.46.0"
  }
}