#!/usr/bin/env bash
# Install the CLI tools these dotfiles expect on Termux (Android).
set -euo pipefail

[[ -n "${TERMUX_VERSION:-}" ]] || {
  echo "Not running in Termux" >&2
  exit 1
}

pkg update -y
pkg install -y zsh git stow fzf zoxide eza fd bat ripgrep jq gh git-delta neovim nodejs golang tmux direnv

dotfiles="$HOME/repos/github.com/reegnz/dotfiles"
if [[ -d "$dotfiles/.git" ]]; then
  git -C "$dotfiles" pull --ff-only
else
  mkdir -p "${dotfiles%/*}"
  git clone https://github.com/reegnz/dotfiles "$dotfiles"
fi
make -C "$dotfiles"
